{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "detectedLanguage": {
      "type": "string"
    },
    "translation": {
      "type": "string"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" }
        },
        "required": ["source", "target"],
        "additionalProperties": false
      }
    }
  },
  "required": ["detectedLanguage", "translation", "segments"],
  "additionalProperties": false
}
