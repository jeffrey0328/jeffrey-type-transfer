{
  "manifest_version": 3,
  "name": "Jeffrey Type Transfer",
  "short_name": "Jeffrey Type Transfer",
  "description": "选中网页输入框文字，通过本机 Codex CLI 或可选的兼容 API 翻译并替换。",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "contextMenus", "scripting", "sidePanel", "storage"],
  "host_permissions": ["http://*/*", "https://*/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["selection-tracker.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 Jeffrey Type Transfer"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Command+Shift+T"
      },
      "description": "翻译并替换当前输入框中的选中文字"
    }
  }
}
